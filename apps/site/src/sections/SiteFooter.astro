---
// F11-SITE-PAGE-07 — el pie: las mismas anclas del menú, el selector de país
// e idioma y el año, calculado al construir.
//
// El correo de contacto existe desde el 2026-09-19 (`CONTACT_EMAIL`).
import Container from "../components/Container.astro";
import MarketSwitcher from "../components/MarketSwitcher.astro";
import { legalPath } from "../config/legal";
import { ANCHORS, BRAND_NAME, CONTACT_EMAIL } from "../config/links";
import type { Route } from "../config/markets";
import type { Alternates } from "../config/seo";
import { getMessages } from "../i18n";

interface Props {
  route: Route;
  /** Igual que en el menú: vacío en la portada, `/es-mx/` en una página legal. */
  anchorBase?: string;
  /** Esta misma página en cada versión, para el selector. Por omisión, las portadas. */
  paths?: Alternates;
}

const { route, anchorBase = "", paths } = Astro.props;
const { nav, footer } = getMessages(route);
const year = new Date().getFullYear();
const links = [
  { href: `${anchorBase}#${ANCHORS.whatItDoes}`, label: nav.whatItDoes },
  { href: `${anchorBase}#${ANCHORS.benefits}`, label: nav.benefits },
  { href: `${anchorBase}#${ANCHORS.plans}`, label: nav.plans },
  { href: `${anchorBase}#${ANCHORS.faq}`, label: nav.faq },
  { href: legalPath(route, "privacy"), label: footer.privacy },
  { href: legalPath(route, "terms"), label: footer.terms },
];
---

<Container as="footer" class="footer">
  <span>
    © {year} {BRAND_NAME}. {footer.tagline}{" "}
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </span>
  <nav aria-label={footer.navLabel}>
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  {/* `#footer-market`: a donde lleva «¿Estás en otro país?» de los precios. */}
  <span id="footer-market">
    <MarketSwitcher route={route} placement="up" align="end" paths={paths} />
  </span>
</Container>

<style>
  :global(.footer) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding-block: 40px;
    color: var(--muted);
    font-size: 0.92rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    list-style: none;
    padding: 0;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
