---
// El botón en píldora de la guía (§6). Con `href` es un enlace; sin él, un
// <button>. El texto llega por el slot: aquí no se escribe ninguno.
import type { HTMLAttributes } from "astro/types";
import type { ButtonVariant } from "./variants";

type Props = { variant?: ButtonVariant } & (
  | ({ href: string } & HTMLAttributes<"a">)
  | ({ href?: undefined } & HTMLAttributes<"button">)
);

const { variant = "dot", class: className, ...rest } = Astro.props;
const classes = ["btn", `btn--${variant}`, className];
// Los tipos se afinan AQUÍ y no en la plantilla: ahí adentro un `<"button">`
// se confunde con una etiqueta.
const linkProps = rest as HTMLAttributes<"a">;
const buttonProps = rest as HTMLAttributes<"button">;
const buttonType = buttonProps.type ?? "button";
// En la plantilla, `type` va DESPUÉS del resto y con su valor por omisión:
// escrito antes, el `type="submit"` de quien lo usa no lo pisaba y el
// formulario de interés no se enviaba (lo cazó el navegador, no una prueba).
---

{
  rest.href !== undefined ? (
    <a class:list={classes} {...linkProps}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...buttonProps} type={buttonType}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 1rem var(--body);
    padding: 14px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn--dot {
    background: var(--dot);
    color: var(--on-dot);
  }
  .btn--ghost {
    background: transparent;
    border-color: var(--on-blue-line);
    color: var(--on-blue);
  }
  .btn--blue {
    background: var(--blue);
    color: var(--on-blue);
  }
  .btn--outline {
    background: transparent;
    border-color: var(--ink);
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn:hover {
      transform: none;
    }
  }
</style>
