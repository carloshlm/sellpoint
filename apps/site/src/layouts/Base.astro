---
// La plantilla de TODAS las páginas del sitio (F11-SITE-BASE-05).
import "../styles/global.css";
import { Font } from "astro:assets";
import { ANCHORS } from "../config/links";
import { getLocale, ROUTES, type Route } from "../config/markets";
import { type Alternates, absoluteUrl, HOME_ALTERNATES, HOME_X_DEFAULT } from "../config/seo";
import { getMessages } from "../i18n";
import { BRAND_BLUE } from "../styles/tokens";

interface Props {
  route: Route;
  /** Por omisión, los de la ruta. Las páginas legales traen los suyos. */
  title?: string;
  description?: string;
  /** La dirección canónica de ESTA página. Por omisión, la portada de la ruta. */
  path?: string;
  /** Esta misma página en cada versión (`hreflang`). Por omisión, las portadas. */
  alternates?: Alternates;
  /** A dónde manda Google a quien no encaja en ninguna versión. */
  xDefault?: string;
  /** Solo la 404: una página de error no se indexa. */
  noindex?: boolean;
}

const { route } = Astro.props;
const locale = getLocale(route);
const messages = getMessages(route);
const {
  title = messages.meta.title,
  description = messages.meta.description,
  path = `/${route}/`,
  alternates = HOME_ALTERNATES,
  xDefault = HOME_X_DEFAULT,
  noindex = false,
} = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(`/og/${locale.language}.png`);
---

<!doctype html>
<html lang={locale.htmlLang} data-route={route}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /*
       * El tema se decide ANTES del primer pintado: por eso el guion va en línea,
       * arriba de los estilos y sin `defer`. Si la persona eligió un tema, manda
       * su elección; si no, no se toca nada y decide `prefers-color-scheme`.
       * `localStorage` puede tronar (modo privado, datos bloqueados): en ese
       * caso el sitio se pinta con el tema del sistema y ya.
       *
       * OJO (F11-SITE-INFRA-02): al ser un guion en línea, la CSP del vhost
       * tiene que autorizarlo por su hash. Si este texto cambia, el hash también.
       */
    }
    <script is:inline>
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
      } catch (_) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      /*
       * F11-SITE-SEO-01. Cada página es canónica de sí misma y declara a sus
       * cinco parejas, ella incluida: Google solo le hace caso a un `hreflang`
       * RECÍPROCO (`test/seo.test.ts` lo comprueba recorriendo el sitio).
       */
    }
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        ROUTES.map((other) => (
          <link
            rel="alternate"
            hreflang={getLocale(other).htmlLang}
            href={absoluteUrl(alternates[other])}
          />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SellPointy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale.htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={BRAND_BLUE} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {/* Solo se precarga la del titular: es lo más grande de la primera pantalla. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href={`#${ANCHORS.main}`}>{messages.a11y.skipToContent}</a>
    <slot />
    <script>
      import "../lead/wire-events";
    </script>
  </body>
</html>
