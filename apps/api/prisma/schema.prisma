// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  taxId     String?  @map("tax_id")
  timezone  String   @default("America/Mexico_City")
  // CHAR(3) con CHECK (currency IN ('MXN','USD')) — el CHECK vive en el SQL de
  // la migración porque Prisma no soporta constraints CHECK en el schema.
  currency  String   @default("MXN") @db.Char(3)
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("tenants")
}

enum UserStatus {
  invited
  active
  suspended

  @@map("user_status")
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  // Nullable: los usuarios nacen invitados, el password llega al aceptar
  passwordHash     String?    @map("password_hash")
  employeeNumber   String?    @map("employee_number")
  firstName        String     @map("first_name")
  lastNamePaternal String     @map("last_name_paternal")
  lastNameMaternal String?    @map("last_name_maternal")
  status           UserStatus @default(invited)
  // CHAR(2) con CHECK (locale IN ('es','en')) — CHECK en el SQL de la migración
  locale           String     @default("es") @db.Char(2)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}
