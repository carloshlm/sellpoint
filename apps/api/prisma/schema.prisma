// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  legalName        String?  @map("legal_name")
  taxId            String?  @map("tax_id")
  // F1-WEB-ONBOARD-01 (paso 1 del wizard): aditivos, nullable — un tenant
  // creado antes de esta migración sigue operando con ambos en NULL.
  address          String?  @map("address")
  // Teléfono del negocio (2026-08-25): editable desde "Mi perfil", nunca lo
  // pide el wizard. El único campo del tenant borrable vía PATCH (null).
  phone            String?  @db.VarChar(20)
  // Tema inicial elegido en el wizard (light|dark|sand|grape). El catálogo
  // cerrado vive en updateTenantSchema, sin CHECK SQL (criterio country).
  theme            String?  @db.VarChar(16)
  templateChoice   String?  @map("template_choice")
  // F1-WEB-ONBOARD-03: el paso 3 (placeholder de almacén, F2, D2) NO tiene
  // columna propia — W4 (verify-report #357) revirtió `warehouseStepSeen`
  // (Deviation 6): con negocio y plantilla completos el piso del wizard ya
  // deriva 4 sin necesitar una señal server-side extra (ver
  // apps/web/src/lib/tenant/steps.ts).
  timezone         String   @default("America/Mexico_City")
  // CHAR(3) con CHECK (currency IN ('MXN','USD','CAD','EUR','GBP')) — el CHECK vive en el SQL de
  // la migración porque Prisma no soporta constraints CHECK en el schema.
  currency         String   @default("MXN") @db.Char(3)
  // Ad-hoc post-Fase 1 (2026-08-16, MERCADOS.md §2): ISO 3166-1 alpha-2,
  // nullable — un tenant preexistente la llena al pasar el paso 1 del
  // wizard de nuevo (ver `apps/web/src/lib/tenant/steps.ts`). Sin CHECK SQL
  // de países: la validación vive en `updateTenantSchema` vía
  // `isCountryCode` (`@sellpoint/shared`), la misma fuente que consume el
  // selector de país del front — un país que se agrega ahí queda válido acá
  // sin nueva migración.
  country          String?  @db.Char(2)
  onboarded        Boolean  @default(false)
  // F7-POS-03: el toggle "Vender sin existencias". La regla efectiva de la
  // venta es `!plan.stockControl || sellWithoutStock` — en Free/Basic es
  // implícita; en Pro/Plus/Premium la decide el admin (default estricto).
  sellWithoutStock Boolean  @default(false) @map("sell_without_stock")
  /// El interruptor de UBICACIONES: muestra el campo "Ubicación" en los
  /// productos y ordena la hoja del inventario físico por recorrido del
  /// almacén. Apagado por defecto — un negocio que no ordena por pasillos no
  /// necesita un campo más en cada alta. No lleva saldo por ubicación: eso
  /// vive en `stock_lots` y se activa con `tracksLots` del producto.
  usesLocations    Boolean  @default(false) @map("uses_locations")
  /// F5-DASH-02: la meta mensual de ventas — el número contra el que el
  /// dashboard pinta «85% alcanzado». NULL = el negocio no persigue meta;
  /// borrable como phone.
  monthlySalesGoal Decimal? @map("monthly_sales_goal") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   User[]
  roles                   Role[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  warehouseScopes         UserWarehouseScope[]

  // Motor de catálogos (Fase 2)
  catalogs          Catalog[]
  catalogFields     CatalogField[]
  catalogRecords    CatalogRecord[]
  products          Product[]
  presentations     ProductPresentation[]
  compositions      ProductComposition[]
  warehouses        Warehouse[]
  stock             StockByWarehouse[]
  services          Service[]
  cashboxSessions   CashboxSession[]
  sales             Sale[]
  saleItems         SaleItem[]
  quotes            Quote[]
  quoteLines        QuoteLine[]
  serviceWarehouses ServiceWarehouse[]

  // Movimientos de inventario (Fase 3)
  stockMovements StockMovement[]
  transfers      Transfer[]
  transferLines  TransferLine[]
  documents      InventoryDocument[]
  documentLines  InventoryDocumentLine[]
  sequences      TenantSequence[]
  productLots    ProductLot[]
  stockLots      StockLot[]

  // Billing (Fase 7)
  subscription         TenantSubscription?
  subscriptionPayments SubscriptionPayment[]
  discounts            TenantDiscount[]
  modules              TenantModule[]

  // Recepción (Fase 9)
  customers            Customer[]
  receptionTurns       ReceptionTurn[]
  billingNotifications BillingNotification[]

  @@map("tenants")
}

enum UserStatus {
  invited
  active
  suspended

  @@map("user_status")
}

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  // f1-auth D1 (decision-email-global, #228): único GLOBAL, no por tenant —
  // login no pide selector de tenant. El unique real es un índice FUNCIONAL
  // sobre lower(email) (Prisma no soporta índices funcionales en el schema,
  // igual que el CHECK de abajo: vive a mano en la migración
  // _auth_login_gateway). NO declarar @unique acá — generaría un índice
  // btree plano redundante/inconsistente con el funcional.
  email              String
  // Nullable: los usuarios nacen invitados, el password llega al aceptar
  passwordHash       String?    @map("password_hash")
  employeeNumber     String?    @map("employee_number")
  firstName          String     @map("first_name")
  lastNamePaternal   String     @map("last_name_paternal")
  lastNameMaternal   String?    @map("last_name_maternal")
  status             UserStatus @default(invited)
  // CHAR(2) con CHECK (locale IN ('es','en')) — CHECK en el SQL de la migración
  locale             String     @default("es") @db.Char(2)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  // F3-HOME-01. El almacén ASIGNADO: desde dónde opera por defecto. Distinto
  // del ALCANCE (`warehouseScopes`, la lista de dónde PUEDE operar): el POS de
  // F4 no puede vender desde "una lista", necesita un almacén concreto.
  // Nullable a propósito — un Viewer contable no opera stock.
  defaultWarehouseId String?    @map("default_warehouse_id") @db.Uuid
  // F7-DB-06: el plano de administración del DUEÑO de la plataforma (no
  // existe SuperAdmin: los roles son por tenant). El guard lo exige en AND
  // con la whitelist BILLING_ADMIN_EMAILS del env. Excluido a propósito de
  // updateUserSchema (un PATCH jamás lo escribe) y NUNCA viaja en el JWT —
  // se consulta por PK solo en /admin/*, para que revocarlo sea inmediato.
  isPlatformAdmin    Boolean    @default(false) @map("is_platform_admin")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  warehouseScopes         UserWarehouseScope[]
  defaultWarehouse        Warehouse?               @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: Restrict)
  // Dos relaciones al mismo modelo: quién REGISTRÓ el movimiento (siempre) y
  // quién lo AUTORIZÓ (opcional, para mermas y ajustes que piden visto bueno).
  movementsCreated        StockMovement[]          @relation("MovementCreatedBy")
  movementsAuthorized     StockMovement[]          @relation("MovementAuthorizedBy")
  transfersCreated        Transfer[]               @relation("TransferCreatedBy")
  transfersReceived       Transfer[]               @relation("TransferReceivedBy")
  transfersCanceled       Transfer[]               @relation("TransferCanceledBy")
  documentsCreated        InventoryDocument[]      @relation("DocumentCreatedBy")
  documentsAuthorized     InventoryDocument[]      @relation("DocumentAuthorizedBy")
  documentsConfirmed      InventoryDocument[]      @relation("DocumentConfirmedBy")
  documentsCanceled       InventoryDocument[]      @relation("DocumentCanceledBy")
  cashboxOpened           CashboxSession[]         @relation("CashboxOpenedBy")
  cashboxClosed           CashboxSession[]         @relation("CashboxClosedBy")
  salesCreated            Sale[]                   @relation("SaleCreatedBy")
  salesCanceled           Sale[]                   @relation("SaleCanceledBy")
  quotesCreated           Quote[]                  @relation("QuoteCreatedBy")
  quotesCanceled          Quote[]                  @relation("QuoteCanceledBy")

  @@index([tenantId])
  @@index([defaultWarehouseId])
  @@map("users")
}

// Refresh rotation con familias: cada login abre una familia; cada refresh
// rota el token DENTRO de la familia. Reuso de un token ya usado = robo
// detectado → se revoca la familia completa (F1-AUTH).
// Sin updated_at a propósito: las filas se escriben máximo dos veces
// (crear + marcar usada/revocada) — created_at alcanza para auditar.
// tenantId (f1-auth AD-3/U1-05): las rutas pre-auth (refresh/verify/reset)
// resuelven el tenant desde la fila del token, sin pasar por la función
// SECURITY DEFINER. Esta tabla SIGUE SIN RLS a propósito (design AD-3): es
// el punto de entrada pre-contexto — toda query es por token_hash (unique),
// jamás un listado.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Hash del token (nunca el token en claro — si la DB se filtra, no hay sesiones)
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

// Tokens de un solo uso con TTL (verificación de email). Solo hash en DB.
// tenantId + SIN RLS: mismo razonamiento que RefreshToken (AD-3).
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("email_verification_tokens")
}

// Tokens de un solo uso con TTL (reset de password). Solo hash en DB.
// tenantId + SIN RLS: mismo razonamiento que RefreshToken (AD-3).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

// Tabla MAESTRA de monedas (global, sin tenant_id, sin RLS). Datos de
// referencia: los INSERT viven en la migración (no en el seed demo) para que
// lleguen a TODOS los entornos por el pipeline. La app solo lee (REVOKE de
// escritura para sellpoint_app en la migración).
model Currency {
  code     String  @id @db.Char(3)
  symbol   String
  decimals Int     @default(2)
  nameEs   String  @map("name_es")
  nameEn   String  @map("name_en")
  isActive Boolean @default(true) @map("is_active")

  @@map("currencies")
}

// ─────────────────────────────────────────────────────────────────────────
// MOTOR DE CATÁLOGOS DINÁMICOS (Fase 2) — ARQUITECTURA.md § 3.3
//
// LEY DE GENERICIDAD (Carlos, 2026-08-16): el motor es AGNÓSTICO DEL RUBRO.
// Acá no hay ni habrá un campo de farmacia, cafetería ni ferretería: que un
// tenant llame a un campo "Sustancia Activa" o "Tipo de Tueste" es DATO que
// él carga en `catalog_fields`, indistinguible para el sistema.
// ─────────────────────────────────────────────────────────────────────────

// Un catálogo del tenant. El de PRODUCTOS es del sistema (`systemKey` =
// 'products', `isSystem` = true, creado en `TenantsService.provision()`): no
// se borra ni se renombra, y sus filas NO viven en `catalog_records` sino en
// la tabla de primera clase `products` — porque F3/F4/F5 le cuelgan FKs duras
// (presentaciones, composición, stock, ventas). Lo que comparte con los
// subcatálogos es el MOTOR de campos, no la tabla de filas.
model Catalog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  systemKey String?  @map("system_key")
  isSystem  Boolean  @default(false) @map("is_system")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  fields        CatalogField[]  @relation("CatalogFields")
  lookupTargets CatalogField[]  @relation("CatalogLookupTarget")
  records       CatalogRecord[]

  // El índice único parcial de (tenant_id, system_key) WHERE system_key IS NOT
  // NULL vive en la migración: Prisma no expresa índices parciales, y sin él
  // un tenant podría terminar con dos catálogos 'products'.
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("catalogs")
}

enum CatalogFieldType {
  text
  number
  lookup

  @@map("catalog_field_type")
}

// Un campo personalizado de un catálogo. `key` es el identificador estable
// (derivado del label al crearlo) con el que se guarda el valor dentro del
// JSONB `attributes` de los registros/productos; `label` es lo que el usuario
// ve y puede cambiar sin migrar datos.
//
// `isArchived` es la guarda del editor (decisión de Carlos, 2026-08-16):
// quitar un campo con datos NO borra sus valores — los oculta, y es
// restaurable. Por eso no hay DELETE en caliente en el camino feliz.
model CatalogField {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  catalogId       String           @map("catalog_id") @db.Uuid
  key             String
  label           String
  fieldType       CatalogFieldType @map("field_type")
  lookupCatalogId String?          @map("lookup_catalog_id") @db.Uuid
  required        Boolean          @default(false)
  position        Int              @default(0)
  isArchived      Boolean          @default(false) @map("is_archived")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  catalog      Catalog  @relation("CatalogFields", fields: [catalogId], references: [id], onDelete: Cascade)
  // `Restrict` explícito, NO el `SetNull` que Prisma pone por default en
  // relaciones opcionales: con SetNull, borrar el catálogo destino dejaría el
  // campo en `field_type='lookup'` con `lookup_catalog_id NULL` — un estado que
  // el CHECK de abajo prohíbe, así que el DELETE fallaría igual pero con un
  // error de constraint confuso en vez de uno de FK claro. El camino feliz es
  // archivar el catálogo (`isActive`), no borrarlo.
  lookupTarget Catalog? @relation("CatalogLookupTarget", fields: [lookupCatalogId], references: [id], onDelete: Restrict)

  // El CHECK `field_type='lookup'` ⇔ `lookup_catalog_id IS NOT NULL` vive en la
  // migración (Prisma no expresa CHECKs). Sin él existirían dos estados
  // imposibles: un lookup que no apunta a nada, y un campo de texto con un
  // destino colgado que nadie lee.
  @@unique([catalogId, key])
  @@index([tenantId])
  @@index([lookupCatalogId])
  @@map("catalog_fields")
}

// Una fila de un SUBCATÁLOGO (ej. "Unidad de Medida": code `kg` → "kilogramos").
// Los productos NO viven acá: tienen su propia tabla de primera clase.
//
// `code` es el campo estándar "Código (Nombre Corto)" que define el cliente,
// único dentro del catálogo — es la llave visible con la que los lookups
// muestran a qué apuntan (aunque internamente guarden el `id`, que es estable
// ante renombres del código).
//
// `attributes` guarda los valores de los campos personalizados, indexado por
// la `key` de `catalog_fields`. Se valida contra esos campos en el service
// (validador puro, sin Ajv — ARQUITECTURA § 3.3). El índice GIN vive en la
// migración: Prisma no lo expresa, y sin él la query inversa que detecta
// "¿alguien referencia este registro por lookup?" haría seq scan.
model CatalogRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  catalogId  String   @map("catalog_id") @db.Uuid
  code       String
  attributes Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, code])
  @@index([tenantId])
  // GIN DECLARADO ACÁ, no solo en SQL a mano: Prisma genera `DROP INDEX` para
  // todo índice que exista en la DB y no conozca por el schema — un índice
  // escrito solo en una migración sobrevive hasta la PRÓXIMA `migrate dev`, que
  // lo borra en silencio. `JsonbPathOps` es el operador de `@>`, el único que
  // usa la query inversa de lookups.
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_records")
}

// Un producto del Catálogo de Productos. Tabla de PRIMERA CLASE, no una fila de
// `catalog_records`: F3/F4/F5 le cuelgan FKs duras (presentaciones,
// composición, stock, líneas de venta) y necesita columnas tipadas
// consultables. Lo que comparte con los subcatálogos es el MOTOR de campos —
// sus campos personalizados son `catalog_fields` del catálogo `products` y sus
// valores viven en el mismo `attributes` JSONB, validados por el mismo
// validador (ARQUITECTURA § 3.3).
//
// `sku` es el campo estándar "Código (Nombre Corto)" de este catálogo: lo
// define el cliente y es único por tenant.
//
// NO tiene `price` ni `cost`: viven en `product_presentations` (decisión de
// Carlos, 2026-08-16 — una sola fuente de verdad). El form de alta los pide y
// crea la presentación base «Unidad ×1»; editarlos después edita esa fila.
model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  sku         String
  name        String
  // Unidad interna del stock, invariable una vez que hay existencias o el
  // producto es componente de otro (ARQUITECTURA § 3.5, validación #2).
  baseUnit    String   @default("unit") @map("base_unit") @db.VarChar(8)
  // Denormalizado a propósito: el POS y las listas filtran por esto en cada
  // request y no pueden pagar un EXISTS sobre `product_compositions`.
  isComposite Boolean  @default(false) @map("is_composite")
  /// Opt-in por producto (F3-LOTS): quien lo enciende exige lote en cada
  /// entrada y sale FEFO; quien no, no ve un lote jamás. NO se puede apagar
  /// si el producto tiene saldo en `stock_lots` — esa guarda vive en el
  /// service, no en la base.
  tracksLots  Boolean  @default(false) @map("tracks_lots")
  /// Dónde SUELE estar en el almacén (pasillo, estante, rack). Dato de
  /// REFERENCIA: no parte el saldo — el stock por ubicación vive en
  /// `stock_lots`, cuya clave es (lote, almacén, ubicación). Sirve para
  /// encontrar el producto y para ordenar la hoja del inventario físico por
  /// recorrido del almacén en vez de por SKU (Carlos, 2026-08-30).
  location    String?  @db.VarChar(64)
  stockMin    Decimal  @default(0) @map("stock_min") @db.Decimal(14, 4)
  attributes  Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  unit              Unit                    @relation(fields: [baseUnit], references: [code])
  presentations     ProductPresentation[]
  components        ProductComposition[]    @relation("CompositionParent")
  usedIn            ProductComposition[]    @relation("CompositionComponent")
  stock             StockByWarehouse[]
  movements         StockMovement[]         @relation("MovementProduct")
  // Salidas de COMPONENTES que originó este compuesto al expandirse: le da al
  // kardex del componente la respuesta a "¿de dónde salió esto?".
  movementsAsParent StockMovement[]         @relation("MovementParentProduct")
  lots              ProductLot[]
  transferLines     TransferLine[]
  documentLines     InventoryDocumentLine[]
  saleItems         SaleItem[]
  quoteLines        QuoteLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  // Declarados en el schema por el mismo motivo que en `catalog_records`: si
  // solo vivieran en el SQL de la migración, la próxima `migrate dev` los
  // borraría. La EXTENSIÓN pg_trgm sí queda en la migración (Prisma no la
  // borra) — ver 20260816201225_products.
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("products")
}

// Cómo se compra y cómo se vende un producto. Acá viven el PRECIO y el COSTO
// (decisión de Carlos, 2026-08-16): una sola fuente de verdad, la que lee el
// POS de F4. El form de alta de producto pide precio/costo y crea la
// presentación base «Unidad ×1» (factor 1); editarlos después edita esa fila.
//
// `factor` es el equivalente en la `base_unit` del producto: "Caja 1L" de un
// producto en `ml` tiene factor 1000.
//
// `allowFractionalInput` lo deriva el server de la categoría de la unidad base
// (`count` → false, resto → true) y el TenantAdmin puede sobrescribirlo. NO es
// cosmético: F3/F4 rechazan cantidades con decimales cuando está en false, y
// el numpad del POS esconde el punto.
model ProductPresentation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  name                 String
  factor               Decimal  @db.Decimal(14, 4)
  isPurchasable        Boolean  @default(true) @map("is_purchasable")
  isSellable           Boolean  @default(true) @map("is_sellable")
  isDefaultSale        Boolean  @default(false) @map("is_default_sale")
  allowFractionalInput Boolean  @map("allow_fractional_input")
  barcode              String?
  price                Decimal? @db.Decimal(14, 2)
  cost                 Decimal? @db.Decimal(14, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
  documentLines InventoryDocumentLine[]
  saleItems     SaleItem[]
  quoteLines    QuoteLine[]

  // El CHECK de `factor > 0` y el índice único PARCIAL de (tenant_id, barcode)
  // WHERE barcode IS NOT NULL viven en la migración. El índice tiene que ser
  // parcial: un @@unique normal trataría a los NULL como valores y solo
  // dejaría UN producto sin código de barras en todo el tenant.
  @@unique([productId, name])
  @@index([tenantId])
  @@map("product_presentations")
}

// La COMPOSICIÓN de un producto compuesto: qué componentes lleva UNA unidad.
// Vocabulario neutro por la LEY de genericidad — `component`, nunca
// `ingredient`: esto arma un lente (armazón + cristales), un kit de ferretería
// o un café, y el motor es el mismo.
//
// El "1 kg de azúcar alcanza para 50 cafés" del pedido de Carlos se guarda
// como "el café lleva 20 gr de azúcar"; el "alcanza para N" se CALCULA en vivo
// contra el stock (F2-BOM-02) en vez de guardarse, porque un número fijo
// mentiría apenas cambiara el stock.
model ProductComposition {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  parentProductId    String   @map("parent_product_id") @db.Uuid
  componentProductId String   @map("component_product_id") @db.Uuid
  // En la `base_unit` del COMPONENTE, no la del padre.
  quantity           Decimal  @db.Decimal(14, 4)
  wastePercentage    Decimal  @default(0) @map("waste_percentage") @db.Decimal(5, 2)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  parent    Product @relation("CompositionParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  // `Restrict`: borrar un producto que es componente de otro dejaría una
  // composición rota en silencio. La UI ofrece desactivarlo en su lugar
  // (ARQUITECTURA § 3.5, validación #3).
  component Product @relation("CompositionComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  // Los CHECK de `quantity > 0`, `waste_percentage` entre 0 y 100 y
  // `parent <> component` viven en la migración. El de autorreferencia solo
  // cubre el ciclo DIRECTO: los indirectos (A→B→C→A) los detecta el DFS del
  // service (F2-BOM-01), porque SQL no puede recorrer el grafo en un CHECK.
  @@unique([parentProductId, componentProductId])
  @@index([tenantId])
  @@index([componentProductId])
  @@map("product_compositions")
}

// Un almacén del tenant. `address` es TEXTO LIBRE a propósito: SellPoint vende
// a 26 mercados y los formatos postales difieren (MERCADOS.md § 4) — el
// desglose colonia/alcaldía/estado del diseño original era México-céntrico.
// Los racks quedaron FUERA de Fase 2 (se deciden con el stock por ubicación).
model Warehouse {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// El código estándar (Carlos, 2026-09-01), como el sku del producto y el
  /// code del servicio: la llave que la persona ve y por la que casa la
  /// planilla de importación. Único por negocio. Si el alta no lo trae, el
  /// service lo genera (`ALM-001`, `ALM-002`…).
  code       String   @db.VarChar(64)
  name       String
  address    String?
  // Contacto estándar de la sucursal (Carlos, 2026-08-26): el ticket pinta
  // la dirección y el teléfono del ALMACÉN con fallback al tenant. `phone`
  // es E.164 canónico y se valida en el DTO (isE164), mismo criterio que
  // Tenant.phone — sin CHECK SQL de formato.
  phone      String?  @db.VarChar(20)
  email      String?
  // Campos dinámicos del catálogo de sistema "warehouses" — mismo motor que
  // products (F2-CAT). El GIN se DECLARA acá para que la shadow DB no lo
  // borre (lección de 20260816201608).
  attributes Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  scopes          UserWarehouseScope[]
  defaultOfUsers  User[]               @relation("UserDefaultWarehouse")
  services        ServiceWarehouse[]
  stock           StockByWarehouse[]
  movements       StockMovement[]      @relation("MovementWarehouse")
  // La contraparte de un traspaso: el almacén del OTRO lado del movimiento.
  movementsLinked StockMovement[]      @relation("MovementLinkedWarehouse")
  transfersOut    Transfer[]           @relation("TransferOrigin")
  transfersIn     Transfer[]           @relation("TransferDestination")
  documents       InventoryDocument[]  @relation("DocumentWarehouse")
  cashboxSessions CashboxSession[]
  sales           Sale[]
  quotes          Quote[]
  documentsLinked InventoryDocument[]  @relation("DocumentLinkedWarehouse")
  stockLots       StockLot[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("warehouses")
}

// F3-SVC-01. Lo que el negocio VENDE pero no almacena: un corte de pelo, una
// reparación, una consulta. Tabla propia y no un `Product` con bandera —
// `Product` arrastra `base_unit`, `tracks_lots`, `stock_min`, composición y
// presentaciones, todo sin sentido acá; y el costo real de la bandera no es el
// schema sino el `WHERE is_service = false` que alguien va a olvidar en alguna
// query de inventario.
//
// `code` es el "nombre corto" con el que se busca en el POS (espejo del `sku`).
// Genérico por LEY: cero campos de rubro.
model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(64)
  name        String
  description String?
  cost        Decimal? @db.Decimal(14, 2)
  price       Decimal? @db.Decimal(14, 2)
  // Campos dinámicos del catálogo de sistema "services": lo específico de
  // cada rubro (duración, comisión…) vive acá, nunca como columna.
  attributes  Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  warehouses ServiceWarehouse[]
  saleItems  SaleItem[]
  quoteLines QuoteLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("services")
}

// F3-SVC-06. En qué almacenes se ofrece cada servicio.
//
// Semántica EXPLÍCITA (decisión de Carlos, 2026-08-19): sin filas, el servicio
// NO se vende en ningún lado — al revés que `user_warehouse_scopes`, donde la
// lista vacía significa "todos". El checklist del form ES la disponibilidad.
//
// A diferencia de aquella tabla, esta SÍ lleva índice por `warehouse_id`: la
// query estrella del POS de F4 es la inversa —«qué servicios se ofrecen en
// ESTE almacén»— y sin el índice cada búsqueda del carrito sería un scan.
model ServiceWarehouse {
  serviceId   String   @map("service_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  // Redundante a propósito: es la columna que la policy `tenant_isolation`
  // compara directo, sin depender de un JOIN (mismo patrón que
  // `user_warehouse_scopes`).
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@id([serviceId, warehouseId])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("service_warehouses")
}

// Existencias por producto y almacén, SIEMPRE en la `base_unit` del producto.
// Nace en F2 (en 0) para que el cálculo de unidades armables de F2-BOM-02 lea
// stock real en vez de un mock; quien la MUEVE es F3 (movimientos).
//
// NO se persiste stock de productos compuestos (`is_composite = true`): su
// disponibilidad se calcula en vivo desde sus componentes (ARQUITECTURA § 3.5).
model StockByWarehouse {
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // El CHECK `quantity >= 0` vive en la migración: stock negativo no es un
  // estado válido del negocio en ningún momento (ARQUITECTURA § 3.5, #4).
  @@id([productId, warehouseId])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("stock_by_warehouse")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 3 — Movimientos de inventario
// ─────────────────────────────────────────────────────────────────────────

enum MovementDirection {
  entry
  exit
}

// El enum nace COMPLETO (decisión de Carlos, 2026-08-17): `sale` y
// `sale_return` están RESERVADOS para el POS de F4 y ningún endpoint de F3 los
// acepta. Ampliar un enum de Postgres después es otra migración, y el kardex
// tiene que poder distinguir una venta de un ajuste desde el día uno.
//
// No existe `production`: un producto compuesto NUNCA persiste stock — se arma
// al vender, expandiendo componentes (ARQUITECTURA § 3.5).
enum MovementReason {
  invoice
  adjustment
  transfer
  customer_return
  sale
  sale_return
  loss
  consumption
  expired
  physical_count
}

/// EL LIBRO MAYOR del inventario: cada fila es un hecho que ya pasó.
///
/// APPEND-ONLY — sin `updated_at`, y la migración hace REVOKE de UPDATE/DELETE
/// para `sellpoint_app` (F3-DB-04). Corregir un movimiento equivocado se hace
/// con OTRO movimiento (`adjustment`), nunca editando la historia: es lo que
/// hace auditable el stock.
///
/// La cantidad SIEMPRE es positiva y SIEMPRE está en la `base_unit` del
/// producto; el signo lo pone `direction`. `presentationId` guarda en qué
/// presentación se capturó ("2 cajas") para que el kardex pueda mostrarlo, pero
/// `quantity` ya viene convertida.
model StockMovement {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Desempate cronológico. `now()` es el instante en que ARRANCÓ la
  /// transacción, así que las N líneas de una misma factura comparten
  /// `created_at` al microsegundo y un UUID v4 no ordena. Sin esta columna, el
  /// `balanceAfter` que calcula la window function de F3-KARDEX-01 daría
  /// saldos intermedios FALSOS. Orden total del kardex: `created_at DESC, seq DESC`.
  /// En la migración es `GENERATED ALWAYS AS IDENTITY`: la base la asigna y
  /// nadie puede elegirla.
  seq               BigInt            @unique @default(autoincrement())
  tenantId          String            @map("tenant_id") @db.Uuid
  /// La línea cuelga de su encabezado. Antes era un `batch_id` implícito —un
  /// UUID sin fila propia donde colgar folio, tipo o motivo—; F3-DOC-01 lo
  /// reemplazó por el documento, que además es lo que se busca y se imprime.
  ///
  /// **Nullable desde F4-SALE-01**: un movimiento pertenece a UNA operación, y
  /// ahora hay dos clases — un documento de inventario **o** una venta.
  /// Exactamente uno, garantizado por CHECK en la base (`num_nonnulls = 1`),
  /// el mismo patrón de `sale_items` y `quote_lines`.
  documentId        String?           @map("document_id") @db.Uuid
  /// La venta que originó este movimiento (F4). Excluyente con `documentId`.
  saleId            String?           @map("sale_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  presentationId    String?           @map("presentation_id") @db.Uuid
  /// El compuesto que originó esta salida al expandirse en sus componentes.
  parentProductId   String?           @map("parent_product_id") @db.Uuid
  direction         MovementDirection
  reasonCode        MovementReason    @map("reason_code")
  reasonNote        String?           @map("reason_note")
  /// Campo contextual genérico: número de factura, remisión, vale de salida.
  /// Sin catálogo de proveedores — un tenant que lo necesite lo arma como
  /// subcatálogo del motor de F2 (LEY de genericidad).
  reference         String?           @db.VarChar(120)
  authorizedBy      String?           @map("authorized_by") @db.Uuid
  /// El OTRO almacén de un traspaso. Va con `reason_code = 'transfer'` o no va.
  linkedWarehouseId String?           @map("linked_warehouse_id") @db.Uuid
  /// Qué LOTE movió esta línea, y desde/hacia qué ubicación. NULL en los
  /// productos que no manejan lotes. Sin esto el kardex no podría explicar
  /// de cuál partida salió cada unidad, que es para lo que existen.
  lotId             String?           @map("lot_id") @db.Uuid
  location          String?           @db.VarChar(64)
  quantity          Decimal           @db.Decimal(14, 4)
  /// Obligatorio en entradas por factura (regla del service, F3-ENTRY-01). F3
  /// solo lo REGISTRA; el costo promedio ponderado se calcula en F5.
  unitCost          Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  createdBy         String            @map("created_by") @db.Uuid
  /// `transaction_timestamp()` y no `now()`: con `@default(now())` **Prisma pone el
  /// timestamp del lado del CLIENTE** y lo manda en el INSERT — verificado el
  /// 2026-08-18 con una contraprueba (dos INSERT crudos con `DEFAULT
  /// CURRENT_TIMESTAMP` en una misma transacción dan UN timestamp aunque haya
  /// un sleep de 50 ms en medio; dos `create` de Prisma dan DOS, separados 1 ms).
  ///
  /// En un libro mayor eso es la hora de un reloj de APLICACIÓN: entre varias
  /// instancias no está sincronizado y puede ir para atrás con un ajuste de
  /// NTP, así que dos movimientos de dos pods pueden quedar guardados en orden
  /// invertido. La hora del asiento la pone la BASE, que es una sola.
  ///
  /// Se escribe `transaction_timestamp()` y no `CURRENT_TIMESTAMP` (son el
  /// mismo valor) por dos razones: dice explícitamente que es la hora de
  /// INICIO DE LA TRANSACCIÓN — que es justo por lo que existe `seq` — y
  /// además Prisma normaliza `CURRENT_TIMESTAMP` a su propio `now()` al
  /// introspeccionar, lo que deja un drift permanente en `migrate diff`.
  createdAt         DateTime          @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  // TODAS las FK van `Restrict`, incluidas las opcionales. Prisma les pone
  // `SetNull` por defecto y en una tabla APPEND-ONLY eso es un UPDATE
  // SILENCIOSO de la historia: borrar una presentación reescribiría
  // movimientos ya asentados y el kardex dejaría de explicar en qué
  // presentación se capturó. Si algo tiene historia, no se borra.
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  lot             ProductLot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  document        InventoryDocument?   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sale            Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product         Product              @relation("MovementProduct", fields: [productId], references: [id])
  parentProduct   Product?             @relation("MovementParentProduct", fields: [parentProductId], references: [id], onDelete: Restrict)
  warehouse       Warehouse            @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  linkedWarehouse Warehouse?           @relation("MovementLinkedWarehouse", fields: [linkedWarehouseId], references: [id], onDelete: Restrict)
  presentation    ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)
  creator         User                 @relation("MovementCreatedBy", fields: [createdBy], references: [id])
  authorizer      User?                @relation("MovementAuthorizedBy", fields: [authorizedBy], references: [id], onDelete: Restrict)

  // Los CHECKs (cantidad > 0, costo >= 0, dirección × motivo, traspaso ↔
  // almacén enlazado) y el índice PARCIAL de `transfer_id` viven en la
  // migración: Prisma no los expresa. El UNIQUE de `seq` sí se declara acá
  // a propósito — si solo viviera en el SQL, el próximo `migrate dev` lo
  // borraría (mismo motivo que los índices GIN de `products`). Los cubre
  // `inventory-schema.integration.spec.ts`.
  @@index([tenantId, productId, createdAt(sort: Desc), seq(sort: Desc)])
  @@index([tenantId, warehouseId, createdAt(sort: Desc)])
  @@index([documentId])
  @@index([presentationId])
  @@index([saleId])
  @@map("stock_movements")
}

enum TransferStatus {
  in_transit
  completed
  canceled
}

/// El traspaso como PROCESO: qué salió de un almacén, qué llegó al otro y en
/// qué punto del viaje está. El STOCK lo mueven los `stock_movements`; esta
/// tabla no mueve nada, recuerda.
///
/// **Sin `folio` propio**: el folio del traspaso es el de su documento de
/// despacho, que es una Salida con `reason_code='transfer'` (decisión del
/// 2026-08-18: el motivo no cambia la serie del folio). Y **sin punteros a
/// documentos**: el único enlace lo lleva `inventory_documents.transfer_id`,
/// porque el documento se confirma DESPUÉS de crear el traspaso y una tabla
/// que no admite rellenar hacia atrás no puede ser el origen del puntero.
///
/// El traspaso **cancelado NO devuelve el stock** al origen: la salida ya
/// ocurrió y es historia. El reingreso es un `adjustment` explícito y
/// auditado — por eso `cancel_reason` es obligatoria al cancelar.
model Transfer {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  originWarehouseId      String         @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus @default(in_transit)
  /// Una sola nota por traspaso, obligatoria (regla del service) si alguna
  /// línea recibió menos de lo enviado. El detalle por línea se deriva de
  /// `quantity_sent - quantity_received`: una sola verdad, sin JSONB.
  discrepancyNote        String?        @map("discrepancy_note")
  createdBy              String         @map("created_by") @db.Uuid
  createdAt              DateTime       @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  receivedBy             String?        @map("received_by") @db.Uuid
  receivedAt             DateTime?      @map("received_at") @db.Timestamptz(6)
  canceledBy             String?        @map("canceled_by") @db.Uuid
  canceledAt             DateTime?      @map("canceled_at") @db.Timestamptz(6)
  cancelReason           String?        @map("cancel_reason")
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  origin      Warehouse           @relation("TransferOrigin", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destination Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  creator     User                @relation("TransferCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  receiver    User?               @relation("TransferReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
  canceller   User?               @relation("TransferCanceledBy", fields: [canceledBy], references: [id], onDelete: Restrict)
  lines       TransferLine[]
  documents   InventoryDocument[]

  // Los CHECK (origen ≠ destino, estado ↔ sus campos) y los índices PARCIALES
  // de `in_transit` viven en la migración: Prisma no los expresa. Los cubre
  // `inventory-schema.integration.spec.ts`.
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("transfers")
}

/// Qué producto y cuánto viaja en un traspaso. `quantity_sent` se llena al
/// despachar y `quantity_received` al confirmar la recepción; hasta entonces
/// es NULL, que es distinto de recibir 0 (una línea que se perdió entera).
model TransferLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  /// Un traspaso mueve un lote CONCRETO, no "algo de este producto": lo que
  /// sale del origen entra al destino como el MISMO lote, con su misma
  /// caducidad. Por eso dos lotes del mismo producto son dos líneas.
  lotId            String?  @map("lot_id") @db.Uuid
  /// SIEMPRE en la `base_unit` del producto: la recepción no elige presentación
  /// (lo enviado ya viene convertido), así que no hay `presentation_id` acá.
  quantitySent     Decimal  @map("quantity_sent") @db.Decimal(14, 4)
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(14, 4)
  createdAt        DateTime @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  // CASCADE y no RESTRICT: un traspaso no se borra nunca (se cancela), así que
  // el cascade es inocuo — y si algún día se borrara uno, dejar líneas
  // huérfanas sería peor.
  transfer Transfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot      ProductLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  // El CHECK de cantidades (`sent > 0`, `0 <= received <= sent`) vive en la
  // migración. `lot_id` y el UNIQUE por lote llegan en F3-DB-07.
  // El UNIQUE vive en la migración como DOS índices PARCIALES y no acá, por la
  // semántica de NULL de Postgres: en un unique normal dos NULL se consideran
  // DISTINTOS, así que `(traspaso, producto, NULL)` no colisionaría consigo
  // mismo y un producto sin lote podría repetirse en el mismo traspaso. Los
  // dos parciales dicen la regla tal cual es: sin lote, un producto una sola
  // vez; con lote, uno por lote. (Mismo gotcha que el unique de `barcode`.)
  @@index([productId])
  @@index([tenantId])
  @@map("transfer_lines")
}

enum InventoryDocumentType {
  entry
  exit
  physical_count
}

enum DocumentStatus {
  draft
  confirmed
  canceled
}

/// El ENCABEZADO de toda operación que toca stock: folio, tipo, estado,
/// almacén, motivo, quién y cuándo.
///
/// **Nace en `draft` con su folio** (decisión de Carlos, 2026-08-18): es lo que
/// permite cargar 80 productos, cerrar el sistema y retomar el movimiento
/// buscándolo por su número — incluso desde otra máquina o por otro usuario,
/// que es la razón de que el borrador viva acá y no en el navegador. Al
/// **confirmar** nacen los `stock_movements` y recién ahí se mueve el saldo;
/// al abandonarlo queda `canceled` CON su folio, así la serie no pierde
/// números.
///
/// **Tres tipos y nada más.** Un traspaso es un `exit` con
/// `reason_code='transfer'` y su recepción un `entry` con el mismo motivo: el
/// motivo viaja adentro del documento, nunca en el folio.
///
/// A diferencia de `stock_movements`, esta tabla **no puede blindarse con
/// REVOKE** — un borrador se edita. La inmutabilidad de lo confirmado la
/// impone un trigger (F3-DOC-02).
model InventoryDocument {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  folio             String                @db.VarChar(20)
  type              InventoryDocumentType
  status            DocumentStatus        @default(draft)
  warehouseId       String                @map("warehouse_id") @db.Uuid
  /// El OTRO almacén, cuando el motivo es traspaso.
  linkedWarehouseId String?               @map("linked_warehouse_id") @db.Uuid
  /// Nullable a propósito: el motivo se elige DENTRO del borrador. Un CHECK lo
  /// vuelve obligatorio al confirmar.
  reasonCode        MovementReason?       @map("reason_code")
  reference         String?               @db.VarChar(120)
  reasonNote        String?               @map("reason_note")
  authorizedBy      String?               @map("authorized_by") @db.Uuid
  /// El ÚNICO puntero entre documento y traspaso. Al revés sería imposible:
  /// el documento se confirma DESPUÉS de crear el traspaso, y uno confirmado
  /// ya no admite que le rellenen una columna hacia atrás.
  transferId        String?               @map("transfer_id") @db.Uuid
  confirmedBy       String?               @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  canceledBy        String?               @map("canceled_by") @db.Uuid
  canceledAt        DateTime?             @map("canceled_at") @db.Timestamptz(6)
  cancelReason      String?               @map("cancel_reason")
  createdBy         String                @map("created_by") @db.Uuid
  createdAt         DateTime              @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Todas las FK en `Restrict`, incluidas las opcionales: aunque el documento
  // sea editable en borrador, lo confirmado es historia y un `SetNull` la
  // reescribiría en silencio (regla nacida en F3-DB-01).
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  warehouse       Warehouse               @relation("DocumentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  linkedWarehouse Warehouse?              @relation("DocumentLinkedWarehouse", fields: [linkedWarehouseId], references: [id], onDelete: Restrict)
  transfer        Transfer?               @relation(fields: [transferId], references: [id], onDelete: Restrict)
  authorizer      User?                   @relation("DocumentAuthorizedBy", fields: [authorizedBy], references: [id], onDelete: Restrict)
  confirmer       User?                   @relation("DocumentConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict)
  canceller       User?                   @relation("DocumentCanceledBy", fields: [canceledBy], references: [id], onDelete: Restrict)
  creator         User                    @relation("DocumentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lines           InventoryDocumentLine[]
  movements       StockMovement[]

  // Los CHECK de estado y el UNIQUE PARCIAL `(transfer_id, type)` viven en la
  // migración: Prisma no expresa ni CHECKs ni índices únicos parciales. Los
  // cubre `inventory-schema.integration.spec.ts`.
  @@unique([tenantId, folio])
  @@index([tenantId, type, status, createdAt(sort: Desc)])
  @@index([tenantId, folio])
  @@index([tenantId, warehouseId, createdAt(sort: Desc)])
  @@index([tenantId, createdBy, status])
  @@map("inventory_documents")
}

/// Lo que el usuario CAPTURÓ, línea por línea. Distinto de los
/// `stock_movements`, que son lo que el ledger HIZO: la línea dice "3 cajas de
/// PAR-500" y los movimientos "36 unidades del lote st10 + 12 del st30",
/// porque FEFO parte una línea en N movimientos y un compuesto la expande en
/// sus componentes. Se conservan las dos después de confirmar: la línea
/// explica el papel, el movimiento explica el saldo.
model InventoryDocumentLine {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  lineNo         Int       @map("line_no")
  productId      String    @map("product_id") @db.Uuid
  presentationId String?   @map("presentation_id") @db.Uuid
  /// Nullable: un borrador admite una línea a medio llenar. La validación dura
  /// es del `confirm`, no de la captura.
  quantity       Decimal?  @db.Decimal(14, 4)
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(14, 2)
  lotCode        String?   @map("lot_code") @db.VarChar(64)
  expiresAt      DateTime? @map("expires_at") @db.Date
  location       String?   @db.VarChar(64)
  /// Solo en `physical_count`: el teórico que el sistema mostró y lo que la
  /// persona contó.
  theoretical    Decimal?  @db.Decimal(14, 4)
  counted        Decimal?  @db.Decimal(14, 4)
  createdAt      DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  // CASCADE: borrar un borrador tiene que llevarse sus líneas. Lo confirmado
  // no se borra (lo impide el trigger de F3-DOC-02 y el RESTRICT de los
  // movimientos), así que el cascade solo alcanza a borradores.
  document     InventoryDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@unique([documentId, lineNo])
  @@index([productId])
  @@index([tenantId])
  @@map("inventory_document_lines")
}

/// El contador de folios: una fila por (tenant, serie).
///
/// Es una TABLA y no un `SEQUENCE` de Postgres a propósito. Un sequence no se
/// deshace con un ROLLBACK, así que cada transacción fallida dejaría un hueco
/// permanente en la numeración; acá el incremento es transaccional y el número
/// vuelve. Además, un sequence global filtraría volumen entre tenants: por el
/// salto entre dos folios se puede estimar cuánto vende el vecino.
///
/// Se descartó `MAX(folio)+1`: exige bloquear la tabla de documentos entera
/// para no entregar el mismo número dos veces.
///
/// El precio del diseño es un lock por fila que dura hasta el COMMIT — por eso
/// `nextFolio` se llama en una transacción CORTA propia (ver `folio.ts`).
model TenantSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  /// La serie. Coincide con el tipo de documento (`entry`, `exit`,
  /// `physical_count`) y en F4 sumará el de ventas.
  key       String   @db.VarChar(32)
  nextValue BigInt   @default(0) @map("next_value")
  /// Cuándo avanzó la serie por última vez. **Sin `@updatedAt`**: ese atributo
  /// hace que el timestamp lo ponga el CLIENTE de Prisma, y esta tabla la
  /// escribe únicamente `nextFolio` por `$queryRaw` — el raw lo saltearía y el
  /// NOT NULL reventaría. La base lo pone al insertar y el helper lo refresca
  /// en el UPDATE. (Misma familia de sorpresa que `@default(now())`, ver
  /// `StockMovement.createdAt`.)
  updatedAt DateTime @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_sequences")
}

/// Una PARTIDA de un producto: el `lot_code` que trae la caja y, si aplica, su
/// caducidad.
///
/// **La caducidad vive acá y no en el stock** porque es una propiedad del lote,
/// no del lugar donde está: el mismo lote st10 en dos almacenes vence el mismo
/// día. Guardarla por almacén permitiría que las dos filas se contradigan.
///
/// Solo existen lotes para productos con `tracks_lots = true` (opt-in, F3-LOTS).
model ProductLot {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  lotCode   String    @map("lot_code") @db.VarChar(64)
  /// Nullable: hay rubros que manejan lote sin vencimiento (una partida de
  /// tornillos, un número de serie de fabricación).
  expiresAt DateTime? @map("expires_at") @db.Date
  createdAt DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stock         StockLot[]
  movements     StockMovement[]
  transferLines TransferLine[]

  @@unique([productId, lotCode])
  // Por acá ordena FEFO: el lote que vence antes sale primero.
  @@index([tenantId, productId, expiresAt])
  @@map("product_lots")
}

/// El saldo de un lote en un almacén y una ubicación.
///
/// **La ubicación PARTE el stock**: "hay 5 en A-3 y 15 en B-1" son dos filas,
/// no una fila con una etiqueta. Por eso `location` entra en la clave primaria
/// y es `NOT NULL DEFAULT ''` — un NULL en una PK no se puede, y `''` significa
/// "sin ubicación" para quien no las usa. Texto libre a propósito: no hay
/// catálogo de racks hasta que un cliente demuestre que lo necesita.
///
/// `stock_by_warehouse` sigue siendo el TOTAL y esta tabla el detalle. La
/// invariante `Σ stock_lots == stock_by_warehouse` la sostiene el ledger
/// (F3-CORE-05), que mueve las dos en la misma transacción — la base no puede
/// expresarla, así que la fija un test de propiedad.
model StockLot {
  lotId       String   @map("lot_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  location    String   @default("") @db.VarChar(64)
  tenantId    String   @map("tenant_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  lot       ProductLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // F7-DB-07: el CHECK `quantity >= 0` se DROPEÓ (igual que en
  // `stock_by_warehouse`) — Basic vende sin control de inventario y el saldo
  // negativo es un estado válido. La barrera la impone StockLedgerService
  // según el plan del tenant, no la base.
  @@id([lotId, warehouseId, location])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("stock_lots")
}

// Tabla MAESTRA de unidades de medida (global, sin tenant_id, sin RLS) —
// F2-DB-01. Mismo molde que `currencies`: los INSERT viven en la migración (no
// en el seed demo) para que lleguen a TODOS los entornos por el pipeline, y la
// app solo LEE (REVOKE de escritura para sellpoint_app en la migración).
//
// `category` es lo que hace posible el conversor de F2-UOM: se convierte SOLO
// dentro de una misma categoría (l↔ml, kg↔gr). Entre categorías no se hace —
// depende de la densidad, y eso es responsabilidad de quien define las
// presentaciones (ARQUITECTURA § 3.5). Su CHECK vive en la migración porque
// Prisma no expresa CHECK constraints.
//
// También decide el default de `allow_fractional_input` de las presentaciones
// (F2-PRESENT): `count` → solo enteros; el resto admite decimales.
model Unit {
  code     String  @id @db.VarChar(8)
  nameEs   String  @map("name_es")
  nameEn   String  @map("name_en")
  category String  @db.VarChar(16)
  isActive Boolean @default(true) @map("is_active")

  products Product[]

  @@map("units")
}

// Audit log de acciones críticas (append-only: sin updated_at, sin FK a users
// para que el log sobreviva a borrados — user_id queda como referencia suave).
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Catálogo GLOBAL de permisos (definido por el sistema, sin tenant_id).
// code formato "modulo:accion" (ej. users:manage); module habilita el
// agrupado de GET /permissions sin parsear strings.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

// Roles POR TENANT (TenantAdmin/Manager/POS_Seller/Viewer se seedean por
// tenant; custom roles del tenant llegan después sin cambio de schema).
model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// F1-SCOPE-01: preparación de warehouse scoping — las tablas reales de
// warehouses llegan en F2 (ver ARQUITECTURA/roadmap), así que acá SOLO
// dejamos la relación user↔warehouse lista para que F2 la use sin volver a
// tocar auth/RBAC. `warehouseId` es UUID crudo, DELIBERADAMENTE SIN
// `@relation`/FK todavía: la tabla `warehouses` no existe hasta F2. Cuando
// aterrice, una migración de F2 agrega
// `ALTER TABLE user_warehouse_scopes ADD CONSTRAINT ... FOREIGN KEY
// (warehouse_id) REFERENCES warehouses(id)` — no requiere backfill porque la
// columna ya nace NOT NULL y sin filas legacy que reconciliar.
model UserWarehouseScope {
  userId      String   @map("user_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  // Redundante con `user.tenantId` a propósito: es la columna que la policy
  // RLS `tenant_isolation` necesita comparar directo, mismo patrón que
  // refresh_tokens/email_verification_tokens/password_reset_tokens
  // (f1-auth AD-3) — ninguna policy de esta tabla depende de un JOIN a users.
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  // F2-DB-07: la FK que F1-SCOPE-01 dejó reservada (backlog S4 de f1-scope).
  // Sin backfill: la columna nació NOT NULL y no hay filas legacy que reconciliar.
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([tenantId])
  @@map("user_warehouse_scopes")
}

// ─────────────────────────────────────────────────────────────────────────
// PUNTO DE VENTA (Fase 4) — F4-DB-01
// ─────────────────────────────────────────────────────────────────────────

enum CashboxSessionStatus {
  open
  closed
}

enum SaleStatus {
  completed
  canceled
}

enum PaymentMethod {
  cash
  card
  transfer
}

/// El TURNO de caja: desde dónde y desde cuándo está vendiendo alguien.
///
/// `warehouse_id` es NOT NULL y ahí está la razón de existir de esta tabla: el
/// POS **no puede vender desde una lista**. El alcance de un usuario dice
/// dónde PUEDE operar (una lista, vacía = todos) y su almacén asignado dice
/// desde dónde opera por defecto — pero descontar stock exige UN almacén
/// concreto. El turno es quien lo fija, y la venta lo hereda de él: la cadena
/// es `usuario.asignado → turno → venta → ledger` (ARQUITECTURA § 3.4).
///
/// El arqueo guarda las TRES cifras y no solo la diferencia: lo declarado por
/// quien cuenta, lo calculado por el sistema y su resta. Guardar solo la resta
/// perdería quién dijo qué, que es justo lo que se audita cuando no cuadra.
/// **La diferencia se registra, no bloquea** — un turno con faltante se cierra
/// igual; esconderlo sería peor que verlo.
model CashboxSession {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  warehouseId    String               @map("warehouse_id") @db.Uuid
  status         CashboxSessionStatus @default(open)
  openedBy       String               @map("opened_by") @db.Uuid
  openedAt       DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedBy       String?              @map("closed_by") @db.Uuid
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz(6)
  /// Lo que la persona contó en la caja al cerrar.
  declaredCash   Decimal?             @map("declared_cash") @db.Decimal(14, 2)
  /// Lo que el sistema sumó de las ventas en efectivo del turno.
  calculatedCash Decimal?             @map("calculated_cash") @db.Decimal(14, 2)
  /// `declared − calculated`. Derivable, pero se persiste: el cálculo de hoy
  /// no debe poder cambiar lo que se auditó ayer.
  cashDifference Decimal?             @map("cash_difference") @db.Decimal(14, 2)
  closingNote    String?              @map("closing_note")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  opener    User      @relation("CashboxOpenedBy", fields: [openedBy], references: [id])
  closer    User?     @relation("CashboxClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  sales     Sale[]

  @@index([tenantId])
  @@index([tenantId, warehouseId, openedAt(sort: Desc)], map: "cashbox_sessions_tenant_warehouse_opened_idx")
  @@map("cashbox_sessions")
}

/// La VENTA. Su folio sale de la serie `VTA` del tenant, igual que `ENT`/`SAL`
/// /`INV` — pero se toma **dentro de la transacción del cobro** y no antes: el
/// carrito vive en el cliente y no hay borrador que retomar, así que un
/// carrito abandonado no debe gastar un número de la serie.
///
/// **No escribe stock.** La venta es LLAMADORA del ledger: `StockLedgerService`
/// .apply(reason='sale')` sigue siendo el único escritor de `stock_movements`,
/// con su FEFO, su expansión de compuestos y su bloqueo de lotes vencidos
/// heredados de F3 sin una línea nueva.
model Sale {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  folio              String        @db.VarChar(32)
  /// El código de barras del ticket: `YYYYMMDD` + consecutivo diario de 4
  /// (`202608240045`). Campo APARTE del folio: el folio es la identidad
  /// contable y nunca reinicia; el código es la etiqueta de escaneo y
  /// reinicia cada día porque cada fecha es una serie nueva. NULL en las
  /// ventas anteriores a la migración. El UNIQUE parcial
  /// `(tenant_id, barcode) WHERE barcode IS NOT NULL` vive en la migración,
  /// igual que el de `idempotency_key`.
  barcode            String?       @db.VarChar(20)
  /// Heredado del turno, no elegido por el cliente: es de donde salió el stock.
  warehouseId        String        @map("warehouse_id") @db.Uuid
  cashboxSessionId   String        @map("cashbox_session_id") @db.Uuid
  /// La cotización que originó esta venta, si la hubo (F4-QUOTE-02).
  quoteId            String?       @unique @map("quote_id") @db.Uuid
  /// Reservada para F9 (receta / documento clínico). **La columna existe, la
  /// tabla no**: sin FK todavía, igual que `warehouse_id` esperó a F2 en
  /// `user_warehouse_scopes`. Tenerla desde ahora evita una migración sobre
  /// una tabla con millones de ventas.
  clinicalDocumentId String?       @map("clinical_document_id") @db.Uuid
  status             SaleStatus    @default(completed)
  /**
   * La clave que el CLIENTE genera al abrir el modal de cobro (F4-SALE-02).
   * Repetir el POST con la misma devuelve ESTA venta, sin tocar stock.
   * Opcional: un cliente que no la mande se comporta como antes.
   */
  idempotencyKey     String?       @map("idempotency_key") @db.VarChar(120)
  paymentMethod      PaymentMethod @map("payment_method")
  subtotal           Decimal       @db.Decimal(14, 2)
  discount           Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  createdBy          String        @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  canceledBy         String?       @map("canceled_by") @db.Uuid
  canceledAt         DateTime?     @map("canceled_at") @db.Timestamptz(6)
  cancelReason       String?       @map("cancel_reason")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  session   CashboxSession  @relation(fields: [cashboxSessionId], references: [id])
  seller    User            @relation("SaleCreatedBy", fields: [createdBy], references: [id])
  canceler  User?           @relation("SaleCanceledBy", fields: [canceledBy], references: [id], onDelete: Restrict)
  items     SaleItem[]
  movements StockMovement[]
  quote     Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([tenantId, folio])
  @@index([tenantId, createdAt(sort: Desc)], map: "sales_tenant_created_idx")
  @@index([tenantId, cashboxSessionId], map: "sales_tenant_session_idx")
  @@map("sales")
}

/// La línea de venta: **un producto o un servicio, nunca los dos ni ninguno.**
///
/// Ese "exactamente uno" es un CHECK en la base y no una validación del
/// service, porque es una regla sobre la FORMA del dato: una línea que no sea
/// ni producto ni servicio no es una línea incompleta, es una imposible. Con
/// dos columnas nullable y sin CHECK, el primer bug de un mapper la escribe.
///
/// `service_id` va con **FK RESTRICT** — es lo que finalmente impide borrar un
/// servicio ya vendido, la deuda que `services.remove` arrastraba con un
/// `TODO(F4)` desde F3. La base lo hace imposible; el 409 con mensaje amable
/// (`services.has_sales`) llega en F4-SALE-01.
///
/// Los precios se copian acá al cobrar y **no se leen del catálogo después**:
/// un ticket de hace tres meses tiene que seguir diciendo lo que cobró, aunque
/// el producto haya cambiado de precio diez veces.
model SaleItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  lineNo         Int      @map("line_no")
  /// F4-CONCEPT-02: `product` | `service` | `concept` (`POS_LINE_KINDS` en shared).
  /// La base cierra la forma de cada tipo con `sale_items_kind_shape`.
  kind           String   @default("product") @db.VarChar(16)
  productId      String?  @map("product_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  /// Solo para producto: en qué presentación se vendió (Caja ×12, Pieza…).
  presentationId String?  @map("presentation_id") @db.Uuid
  /// SOLO en un concepto: la venta nunca tuvo texto porque el ticket lo lee
  /// del catálogo, y un concepto no tiene catálogo. Se copia de la
  /// cotización al cobrar; un producto con este campo rebota en el CHECK.
  conceptDescription String? @map("concept_description")
  /// De dónde salió la línea (módulo + id), como dos strings OPACOS que el
  /// POS guarda y devuelve sin entenderlos. Van en par o no van.
  sourceModule   String?  @map("source_module") @db.VarChar(32)
  sourceRef      String?  @map("source_ref") @db.Uuid
  /// Lo que el cajero tecleó, en la presentación elegida.
  quantity       Decimal  @db.Decimal(14, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  /// F5-DASH-01: el costo promedio ponderado CONGELADO al cobrar, en la misma
  /// unidad que unitPrice (la presentación vendida) — así la utilidad es
  /// `(unitPrice − unitCost) × quantity` sin saber de factores. NULL cuando el
  /// producto nunca se compró con costo (nunca 0 fingido) y en servicios. Las
  /// ventas anteriores a la columna quedan NULL a propósito: la utilidad se
  /// calcula solo desde acá (Carlos, 2026-08-31 — exactitud sobre historia).
  unitCost       Decimal? @map("unit_cost") @db.Decimal(14, 4)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  sale         Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@unique([saleId, lineNo])
  @@index([tenantId])
  @@index([productId])
  @@index([serviceId])
  @@index([tenantId, sourceModule, sourceRef], map: "sale_items_source_idx")
  @@map("sale_items")
}

enum QuoteStatus {
  open
  loaded
  canceled
}

/// La COTIZACIÓN: una lista con folio, no una operación.
///
/// Adelantada de F9 a F4 (Carlos, 2026-08-20) por el caso de un mostrador de
/// recepción antes de la caja. Tres decisiones la definen, y las tres se ven
/// en lo que esta tabla NO tiene:
///
///  · **sin `valid_until` ni estado `expired`** — no maneja vigencia. Los
///    precios impresos son de REFERENCIA y al cargarla en el POS se recalculan
///    con el catálogo vigente, así que no hay promesa que pueda vencer;
///  · **sin `customer_id`** — los clientes llegan en su fase;
///  · **sin una sola FK al ledger ni a `inventory_documents`** — cotizar no
///    mueve stock, y que sea imposible referenciar un movimiento desde acá es
///    la forma estructural de decirlo.
///
/// `warehouse_id` es el almacén del COTIZADOR (no exige turno: cotizar no toca
/// dinero). Sirve para filtrar sus lookups y para el reporte; el almacén que
/// manda al cobrar es el del TURNO, que puede ser otro.
model Quote {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  folio       String      @db.VarChar(32)
  warehouseId String      @map("warehouse_id") @db.Uuid
  status      QuoteStatus @default(open)
  /// Suma de las líneas a precio de REFERENCIA. No es lo que se va a cobrar.
  total       Decimal     @db.Decimal(14, 2)
  note        String?
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Cuándo se volcó al carrito de una venta (F4-QUOTE-02).
  loadedAt    DateTime?   @map("loaded_at") @db.Timestamptz(6)
  canceledBy  String?     @map("canceled_by") @db.Uuid
  canceledAt  DateTime?   @map("canceled_at") @db.Timestamptz(6)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  author    User        @relation("QuoteCreatedBy", fields: [createdBy], references: [id])
  canceler  User?       @relation("QuoteCanceledBy", fields: [canceledBy], references: [id], onDelete: Restrict)
  lines     QuoteLine[]
  /// La venta que la cargó, si llegó a cobrarse. Uno a uno: una cotización se
  /// carga UNA vez (`sales.quote_id` es UNIQUE).
  sale      Sale?

  @@unique([tenantId, folio])
  @@index([tenantId, createdAt(sort: Desc)], map: "quotes_tenant_created_idx")
  @@index([tenantId, status], map: "quotes_tenant_status_idx")
  @@map("quotes")
}

/// La línea de cotización: **el mismo shape que `SaleItem`, a propósito.**
///
/// Que se parezcan tanto no es duplicación por descuido: es lo que hace que
/// volcar una cotización al carrito sea un mapeo directo y no una traducción.
/// La diferencia está en el significado de `unit_price` — acá es de
/// REFERENCIA, y `for-sale` lo descarta y relee el catálogo.
///
/// Las FKs de catálogo van con **RESTRICT**, igual que en `sale_items`. El
/// primer intento fue SET NULL —borrar un servicio cotizado debería poder
/// hacerse, razoné— y un test lo tumbó: SET NULL deja la línea con CERO
/// referencias y viola su propio CHECK de «exactamente uno». Se conservó el
/// CHECK fuerte; el costo es que un ítem cotizado ya no se BORRA, se DESACTIVA
/// (el camino que el catálogo ya ofrece). `description` sigue guardando lo que
/// decía el papel: sobrevive a que el producto cambie de nombre.
model QuoteLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  lineNo         Int      @map("line_no")
  /// F4-CONCEPT-02: `product` | `service` | `concept`. Un concepto no lleva
  /// producto, servicio ni presentación: es `description` + `unitPrice`.
  kind           String   @default("product") @db.VarChar(16)
  productId      String?  @map("product_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  presentationId String?  @map("presentation_id") @db.Uuid
  /// Origen opaco (módulo + id) de la línea, en par o nada. Ver `SaleItem`.
  sourceModule   String?  @map("source_module") @db.VarChar(32)
  sourceRef      String?  @map("source_ref") @db.Uuid
  /// Lo que se cotizó, en texto. Sobrevive a que el producto se borre o cambie
  /// de nombre: el papel que el cliente se llevó decía ESTO.
  description    String
  quantity       Decimal  @db.Decimal(14, 4)
  /// De REFERENCIA. Al cargarla en el POS se recalcula del catálogo vigente.
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  quote        Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@unique([quoteId, lineNo])
  @@index([tenantId])
  @@index([tenantId, sourceModule, sourceRef], map: "quote_lines_source_idx")
  @@map("quote_lines")
}

// ═══════════════════════════════════════════════════════════════════════════
// Billing (Fase 7) — planes, suscripciones y cobro MANUAL
//
// `plans` y `plan_prices` son catálogo GLOBAL sin tenant_id y SIN RLS (mismo
// criterio que `permissions`/`units`). Las cuatro tablas con tenant_id llevan
// la policy canónica `tenant_isolation` MÁS `billing_admin_bypass` (solo
// ellas): el backoffice del dueño y el cron leen cross-tenant por
// `PrismaService.withBillingAdminContext()` — la ÚNICA puerta, regla dura
// hermana de AD-1. Un SELECT a una tabla de negocio desde ese contexto sigue
// devolviendo cero filas (fijado por test).
// ═══════════════════════════════════════════════════════════════════════════

/// El catálogo de planes: 5 filas sembradas en la migración (free/basic/pro/
/// plus/premium). Lo que el enforcement lee en caliente va en COLUMNA (con
/// CHECK); la matriz de booleanos vive en `features` JSONB (validada con
/// `planFeaturesSchema` de shared al leer y escribir) porque el dueño la
/// ajusta desde el backoffice sin migración.
///
/// Los PRECIOS no viven aquí: viven en `plan_prices`, por MERCADO. `free` es
/// una fila real (el modo gratuito es dato editable, no un `if`): write=off,
/// 10 ventas/día. `premium` no publica precio — el suyo es
/// `tenant_subscriptions.custom_price`.
model Plan {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // CHECK (code IN ('free','basic','pro','plus','premium')) en la migración.
  code        String  @unique @db.VarChar(16)
  name        String  @db.VarChar(64)
  description String?
  sortOrder   Int     @default(0) @map("sort_order") @db.SmallInt
  // free y premium no se publican con precio en la pantalla de planes.
  isPublic    Boolean @default(true) @map("is_public")
  isActive    Boolean @default(true) @map("is_active")

  // Límites y flags calientes. NULL = ilimitado.
  maxUsers        Int?    @map("max_users")
  maxWarehouses   Int?    @map("max_warehouses")
  dailySalesLimit Int?    @map("daily_sales_limit")
  writeAccess     Boolean @default(true) @map("write_access")
  stockControl    Boolean @default(true) @map("stock_control")
  features        Json    @default("{}")

  // Enchufe de la pasarela (POSPUESTO). Los price IDs van en `plan_prices`:
  // en Stripe el precio es por moneda.
  gatewayProductId String? @map("gateway_product_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices        PlanPrice[]
  subscriptions TenantSubscription[]
  payments      SubscriptionPayment[]

  @@map("plans")
}

/// El precio de un plan en un MERCADO (país). El precio es por mercado, no
/// por tipo de cambio: $199 MXN ≈ $11 USD sería regalado contra Square.
/// Resolución: la fila del `country` del tenant → fallback a la fila `US`
/// (default internacional). free y premium no tienen filas.
model PlanPrice {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId       String  @map("plan_id") @db.Uuid
  country      String  @db.Char(2)
  currency     String  @db.Char(3)
  priceMonthly Decimal @map("price_monthly") @db.Decimal(14, 2)
  // CHECK (price_yearly = price_monthly * 10) en la migración: 2 meses gratis
  // es una regla de la casa, no una coincidencia del seed.
  priceYearly  Decimal @map("price_yearly") @db.Decimal(14, 2)

  gatewayPriceMonthlyId String? @map("gateway_price_monthly_id") @db.VarChar(64)
  gatewayPriceYearlyId  String? @map("gateway_price_yearly_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, country])
  @@map("plan_prices")
}

/// UNA suscripción por tenant. El `anchor_day` (1-31) se fija con el PRIMER
/// pago y NUNCA se recalcula: es lo único que sostiene la cadena
/// 31-ene → 28-feb → 31-mar. `service_period_*` es lo PAGADO; `due_at` es la
/// fecha de cobro del siguiente período (hoy coinciden; con pasarela
/// divergirán). Los CHECKs de coherencia por estado viven en la migración:
/// un `active` sin `due_at` no puede existir ni por bug.
model TenantSubscription {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid
  // CHECK (status IN ('trialing','active','past_due','free','canceled')).
  status   String @db.VarChar(16)

  // CHECK (billing_cycle IN ('monthly','yearly')); NULL en trial/free.
  billingCycle String? @map("billing_cycle") @db.VarChar(8)
  anchorDay    Int?    @map("anchor_day") @db.SmallInt

  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  servicePeriodStart DateTime? @map("service_period_start") @db.Timestamptz(6)
  servicePeriodEnd   DateTime? @map("service_period_end") @db.Timestamptz(6)
  dueAt              DateTime? @map("due_at") @db.Timestamptz(6)
  graceEndsAt        DateTime? @map("grace_ends_at") @db.Timestamptz(6)

  // Solo Premium. La invariante "plan sin precio publicado ⇒ custom_price"
  // la impone BillingService (no hay CHECK cross-tabla) y la fija un test.
  customPrice Decimal? @map("custom_price") @db.Decimal(14, 2)

  canceledAt        DateTime? @map("canceled_at") @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  notes             String?

  // Enchufe de la pasarela (POSPUESTO).
  gateway               String  @default("manual") @db.VarChar(16)
  gatewayCustomerId     String? @map("gateway_customer_id") @db.VarChar(64)
  gatewaySubscriptionId String? @map("gateway_subscription_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  plan          Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments      SubscriptionPayment[]
  notifications BillingNotification[]

  // El barrido del cron entra por estos dos.
  @@index([status, dueAt])
  @@index([status, trialEndsAt])
  @@map("tenant_subscriptions")
}

/// Un pago registrado (hoy a mano por el dueño; mañana también por la
/// pasarela — `gateway`/`external_id` son ese enchufe, con su UNIQUE parcial
/// para la idempotencia del webhook). Las columnas de plan/precio son
/// SNAPSHOT: si Plus sube de precio, el recibo de agosto sigue diciendo lo
/// que se cobró. Un pago NO se borra: se anula (`voided`) con razón, y el
/// período de servicio se recalcula desde los pagos vivos — es dinero, la
/// corrección deja rastro.
model SubscriptionPayment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  planId       String @map("plan_id") @db.Uuid
  planCode     String @map("plan_code") @db.VarChar(16)
  billingCycle String @map("billing_cycle") @db.VarChar(8)

  grossAmount    Decimal @map("gross_amount") @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  // CHECK (amount = gross_amount - discount_amount) en la migración.
  amount         Decimal @db.Decimal(14, 2)
  currency       String  @default("MXN") @db.Char(3)
  discountId     String? @map("discount_id") @db.Uuid

  // CHECK (method IN ('transfer','cash','card','other','courtesy')).
  method           String  @db.VarChar(16)
  gateway          String  @default("manual") @db.VarChar(16)
  gatewayReference String? @map("gateway_reference") @db.VarChar(128)
  externalId       String? @map("external_id") @db.VarChar(128)

  paidAt      DateTime @map("paid_at") @db.Timestamptz(6)
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)

  // CHECK (status IN ('recorded','voided')).
  status     String    @default("recorded") @db.VarChar(16)
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  // Sin FK a users a propósito: los escribe también el cron/backoffice desde
  // el contexto de billing, y el rastro humano completo vive en audit_logs.
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason")
  recordedBy String?   @map("recorded_by") @db.Uuid
  notes      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, paidAt(sort: Desc)])
  @@index([subscriptionId, periodEnd(sort: Desc)])
  @@map("subscription_payments")
}

/// Un cupón por tenant con vigencia: monto fijo por período ("-$200/mes
/// durante 12 períodos") o gratis por un rango de fechas. UN solo activo por
/// tenant (UNIQUE parcial en la migración): no se apilan — se revoca uno y
/// se otorga otro. El monto va en la MONEDA del tenant.
model TenantDiscount {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  // CHECK (kind IN ('fixed_amount','free')); fixed_amount exige amount > 0.
  kind     String @db.VarChar(16)

  amount   Decimal? @db.Decimal(14, 2)
  currency String   @default("MXN") @db.Char(3)

  startsAt       DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(6)
  maxPeriods     Int?      @map("max_periods") @db.SmallInt
  appliedPeriods Int       @default(0) @map("applied_periods") @db.SmallInt

  reason    String?
  isActive  Boolean @default(true) @map("is_active")
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_discounts")
}

/// F9-MOD-02 — qué módulo avanzado tiene activo cada negocio por encima de su
/// plan (Recepción es el primero). Tabla y no JSONB: guarda quién y cuándo, y
/// sobrevive a `changePlan`. El catálogo de claves es CÓDIGO (`MODULE_KEYS`
/// en packages/shared); por eso `module_key` no lleva CHECK y el resolver
/// descarta con WARN una clave que ya no exista. Lleva la RLS canónica y es
/// la quinta tabla del bypass acotado del backoffice.
model TenantModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key") @db.VarChar(32)
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  enabledBy String?  @map("enabled_by") @db.Uuid
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

/// El registro de avisos enviados. El UNIQUE (suscripción, kind, ancla) ES la
/// idempotencia del cron: se inserta ANTES de mandar el correo, y si el job
/// corre dos veces el segundo INSERT rebota con 23505 y el mail no sale.
model BillingNotification {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  // CHECK (kind IN (...)) en la migración — el catálogo de avisos.
  kind           String @db.VarChar(32)

  // El vencimiento del que habla el aviso: lo que lo hace único.
  anchorAt DateTime @map("anchor_at") @db.Timestamptz(6)
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, kind, anchorAt], map: "billing_notifications_dedup_uq")
  @@map("billing_notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Recepción (Fase 9, primer módulo vertical)
// ─────────────────────────────────────────────────────────────────────────

/// F9-RECEP-02 — la PERSONA del negocio: el cliente. Se llama `customers` y
/// no `reception_persons`: la usa Recepción hoy y la usarán cotizaciones,
/// ventas y lo clínico (`patients` será extensión 1‑1, nunca una segunda
/// tabla de personas). `birth_date` y no `age`: la edad se CALCULA (Carlos,
/// 2026-09-02). `attributes` nace sin motor de catálogos (la columna y el GIN
/// cuestan cero hoy; cablearla exige un catálogo de sistema con backfill) y el
/// DTO no la acepta todavía. `is_active` existe para el día en que ventas
/// referencie clientes con FK RESTRICT; hoy la UI no lo expone.
model Customer {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  firstName        String    @map("first_name")
  lastNamePaternal String    @map("last_name_paternal")
  lastNameMaternal String?   @map("last_name_maternal")
  // CHECK: no futura. Columna DATE: un calendario, sin zona.
  birthDate        DateTime? @map("birth_date") @db.Date
  // CHECK: E.164 (misma regla que tenants.phone).
  phone            String?   @db.VarChar(20)
  email            String?
  notes            String?
  attributes       Json      @default("{}")
  isActive         Boolean   @default(true) @map("is_active")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  turns  ReceptionTurn[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, phone])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("customers")
}

/// F9-RECEP-03 — un turno de Recepción. El número reinicia con el DÍA DEL
/// NEGOCIO: cada `business_date` es una serie nueva en `tenant_sequences`
/// (`reception_turn:YYYYMMDD`), y el UNIQUE es el cinturón. «Eliminar» un
/// cliente deja `customer_id` en NULL y conserva `customer_name`: el
/// historial del día no pierde a quién se atendió.
/// CHECKs: status IN ('waiting','attended'); number > 0;
/// (status = 'attended') = (attended_at IS NOT NULL).
model ReceptionTurn {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  businessDate DateTime  @map("business_date") @db.Date
  number       Int
  customerId   String?   @map("customer_id") @db.Uuid
  customerName String?   @map("customer_name") @db.VarChar(200)
  status       String    @default("waiting") @db.VarChar(16)
  attendedAt   DateTime? @map("attended_at") @db.Timestamptz(6)
  attendedBy   String?   @map("attended_by") @db.Uuid
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, businessDate, number])
  @@index([tenantId, businessDate, number(sort: Desc)])
  @@map("reception_turns")
}
