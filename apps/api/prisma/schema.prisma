// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  taxId     String?  @map("tax_id")
  timezone  String   @default("America/Mexico_City")
  // CHAR(3) con CHECK (currency IN ('MXN','USD')) — el CHECK vive en el SQL de
  // la migración porque Prisma no soporta constraints CHECK en el schema.
  currency  String   @default("MXN") @db.Char(3)
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]
  roles Role[]

  @@map("tenants")
}

enum UserStatus {
  invited
  active
  suspended

  @@map("user_status")
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  email            String
  // Nullable: los usuarios nacen invitados, el password llega al aceptar
  passwordHash     String?    @map("password_hash")
  employeeNumber   String?    @map("employee_number")
  firstName        String     @map("first_name")
  lastNamePaternal String     @map("last_name_paternal")
  lastNameMaternal String?    @map("last_name_maternal")
  status           UserStatus @default(invited)
  // CHAR(2) con CHECK (locale IN ('es','en')) — CHECK en el SQL de la migración
  locale           String     @default("es") @db.Char(2)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  roles  UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Catálogo GLOBAL de permisos (definido por el sistema, sin tenant_id).
// code formato "modulo:accion" (ej. users:manage); module habilita el
// agrupado de GET /permissions sin parsear strings.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

// Roles POR TENANT (TenantAdmin/Manager/POS_Seller/Viewer se seedean por
// tenant; custom roles del tenant llegan después sin cambio de schema).
model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
