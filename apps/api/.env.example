# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Postgres 16 del docker-compose.dev.yml (pnpm dev:up)
# Runtime de la API: usuario SIN privilegios (sujeto a RLS)
DATABASE_URL=postgresql://sellpoint_app:sellpoint_app@localhost:5432/sellpoint_dev
# CLI de Prisma (migrate/seed): superuser — bypasea RLS y puede crear roles
DATABASE_URL_ADMIN=postgresql://sellpoint:sellpoint@localhost:5432/sellpoint_dev
# Las PRUEBAS no usan estas dos: van solas a sellpoint_test (F0-DB-04). La crea
# apps/api/scripts/ensure-test-db.mjs antes de cada corrida; si quieres otra,
# exporta DATABASE_URL_ADMIN con un nombre que contenga "test".

# Redis 7 del docker-compose.dev.yml (pnpm dev:up)
REDIS_URL=redis://localhost:6379

# Origins permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# --- f1-auth: JWT RS256 (AD-4) ---
# Generar con: pnpm --filter api exec bash scripts/generate-keys.sh
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=sellpoint-api
JWT_AUDIENCE=sellpoint-app

# --- f1-auth: cookie de refresh (AD-5) ---
# En dev, Path=/auth (sin nginx que stripee /api). COOKIE_DOMAIN queda
# SIEMPRE ausente/vacío — no lo definas acá.
REFRESH_COOKIE_PATH=/auth

# --- f1-auth: mail (AD-9) ---
# console loguea el link en vez de enviar — ideal para dev local
MAIL_DRIVER=console
APP_URL=http://localhost:5173

# --- f1-auth: throttling (AD-7) — apagado por defecto en dev/test ---
THROTTLE_ENABLED=false