# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Postgres 16 del docker-compose.dev.yml (pnpm dev:up)
DATABASE_URL=postgresql://sellpoint:sellpoint@localhost:5432/sellpoint_dev

# Redis 7 del docker-compose.dev.yml (pnpm dev:up)
REDIS_URL=redis://localhost:6379