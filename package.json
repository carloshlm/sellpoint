{
  "name": "sellpoint",
  "version": "1.0.4",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:up": "docker compose -f infrastructure/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f infrastructure/docker-compose.dev.yml down",
    "lint": "biome check .",
    "lint:packages": "turbo run lint",
    "format": "biome format --write .",
    "test": "turbo run test --concurrency=1",
    "typecheck:full": "turbo run typecheck:full",
    "release": "commit-and-tag-version",
    "release:first": "commit-and-tag-version --release-as 1.0.0",
    "release:dry": "commit-and-tag-version --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commit-and-tag-version": "^13.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  }
}
