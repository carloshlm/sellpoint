# Plantilla de /opt/sellpoint/.env — NO se completa acá ni pasa por el chat.
#
# El bootstrap/deploy genera el archivo real DIRECTO en el server (D9 del
# proposal f0-deploy). Este archivo es solo documentación de qué variables
# existen y qué formato esperan. Permisos del real: 600, owner deploy.
#
# Un solo archivo: docker compose lo usa tanto para interpolar ${IMAGE_TAG}
# en docker-compose.prod.yml como para `env_file:` de api/postgres/migrate.

NODE_ENV=production
PORT=3000

# --- Postgres ---
# Gotcha: @, / y : rompen la URI de DATABASE_URL. Generar con
# `openssl rand -base64 32 | tr -d '/+='` (alfanumérico, sin caracteres especiales).
POSTGRES_USER=sellpoint
POSTGRES_PASSWORD=
POSTGRES_DB=sellpoint_prod

# Runtime de la API: sellpoint_app, SIN privilegios, sujeto a RLS de verdad
# (f1-auth U1-01/R1 del design). CARLOS: setear el password real con
# `ALTER ROLE sellpoint_app PASSWORD '<pass>'` en el server ANTES de
# reescribir este valor acá (el rol lo crea la migración app_db_user sin
# password) — ver U1-02 (manual, bloqueante) en sdd/f1-auth/tasks.
SELLPOINT_APP_PASSWORD=
DATABASE_URL=postgresql://sellpoint_app:<SELLPOINT_APP_PASSWORD>@postgres:5432/sellpoint_prod
# CLI de migraciones (`prisma migrate deploy`) y seed: superuser, bypasea
# RLS y puede crear roles (CREATE ROLE ... BYPASSRLS de U1-05). Solo lo usa
# el job one-shot `migrate`, JAMÁS el runtime de la api.
DATABASE_URL_ADMIN=postgresql://sellpoint:<POSTGRES_PASSWORD>@postgres:5432/sellpoint_prod

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- App / auth (D6 del proposal vps-multidominio) ---
# Dos ambientes (2026-08-26): producción vive en app.sellpointy.com (el apex
# sellpointy.com queda para la landing futura y redirige 301 a app). Durante
# la transición desde system.laradoc.com, CORS lleva AMBOS dominios; al
# cerrar la fase 7 (301 del viejo), system sale de la lista.
APP_URL=https://app.sellpointy.com

# --- CORS (defensa en profundidad; VITE_API_URL relativo ya evita el problema, D8) ---
CORS_ORIGINS=https://app.sellpointy.com,https://system.laradoc.com

# COOKIE_DOMAIN: ausente/vacío a propósito (D6) — cookie host-only, NUNCA
# Domain=.laradoc.com (el sitio PHP del ápice no debe poder verla).
# env.schema.ts hace fallar el boot si esto llega con un valor no vacío.
# COOKIE_DOMAIN=

# f1-auth AD-5: nginx stripea /api antes de llegar a la api — el path real
# que ve Express es /auth, pero el navegador scopea la cookie por el path
# QUE VIO, o sea /api/auth. Obligatoria, sin default (R9 del design): un
# default que "funciona" en dev es justo el tipo de var que se olvida en prod.
REFRESH_COOKIE_PATH=/api/auth

# --- JWT RS256 (f1-auth AD-4) ---
# Las claves se generan EN el server (openssl), NUNCA en la laptop ni en CI.
# kid se deriva de la clave pública (thumbprint) — no hay env var de kid.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=sellpoint-api
JWT_AUDIENCE=sellpoint-app

# --- Mail (f1-auth AD-9) ---
# console/noop están PROHIBIDOS cuando NODE_ENV=production (env.schema.ts
# hace fallar el boot). Gate de deploy (R8): no activar resend hasta que
# system.laradoc.com tenga SPF+DKIM verificados. RESEND_API_KEY es
# compartida con cert-expiry-check.sh — se documenta una sola vez, más abajo.
MAIL_DRIVER=resend
# Con sellpointy.com verificado en Resend (SPF+DKIM) pasa a
# no-reply@sellpointy.com; hasta entonces se queda el remitente viejo.
MAIL_FROM=no-reply@sellpointy.com

# --- Throttling (f1-auth AD-7) ---
# TRUST_PROXY_HOPS=1 (no `true`): confía SOLO en el último hop, que es
# nginx-edge — con `true` cualquier cliente podría falsear su X-Forwarded-For
# y evadir el rate limit. Defaults de env.schema.ts alcanzan para prod;
# se documentan acá para que quede explícito qué está vigente.
TRUST_PROXY_HOPS=1
THROTTLE_ENABLED=true

# --- Imágenes (deploy.yml las escribe en cada corrida) ---
GHCR_OWNER=carloshlm
IMAGE_TAG=REEMPLAZAR_CON_SHA_COMPLETO  # SIEMPRE un SHA de commit, nunca latest (D10: rollback por tag)

# --- Gobierno de recursos (D5 del proposal vps-multidominio) ---
# Sin esto, V8 elige el heap por la RAM del HOST (~1GB) en vez del mem_limit
# del container (512M): el GC no se apura y el RSS crece hasta rozar el
# límite del sistema antes de trabajar en serio. Con 256MB el GC es agresivo
# mucho antes y un leak muere con stack trace de V8, no con un OOM-kill mudo.
NODE_OPTIONS=--max-old-space-size=256

# --- Alerta de expiración de certs (D3 del proposal vps-multidominio) ---
# Consumidas por scripts/cert-expiry-check.sh (cron semanal). Si alguna
# falta, el script degrada a log — nunca falla por config ausente.
# RESEND_API_KEY también la usa MAIL_DRIVER=resend (f1-auth AD-9, arriba).
# ALERT_EMAIL=tu-email@ejemplo.com
RESEND_API_KEY=re_xxxx  # la carga Carlos a mano en el server, jamás en git

# ============================================================================
# SANDBOX (/opt/sellpoint-sandbox/.env) — mismo formato, valores PROPIOS.
# El sandbox es una producción de ensayo: NODE_ENV=production (el enum no
# admite otra cosa y esa paridad es el punto), diferenciado SOLO por estas
# variables. NUNCA reusar credenciales de producción:
#   POSTGRES_DB=sellpoint_sandbox  y  POSTGRES_PASSWORD / SELLPOINT_APP_PASSWORD propios
#   JWT_PRIVATE_KEY_BASE64 / JWT_PUBLIC_KEY_BASE64  generadas EN el server (openssl), nunca las de prod
#   APP_URL=https://sandbox.sellpointy.com
#   CORS_ORIGINS=https://sandbox.sellpointy.com
#   MAIL_FROM=sandbox@sellpointy.com   ← que un correo del sandbox se note desde el asunto
#   NODE_OPTIONS=--max-old-space-size=128   ← el cap del contenedor es 256M
#   IMAGE_TAG=<lo escribe el pipeline de la rama develop>
# Sin backups: el sandbox se recupera re-migrando y re-sembrando, jamás
# restaurando (backup-postgres.sh no lo conoce y así debe seguir).
# ============================================================================
