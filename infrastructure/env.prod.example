# Plantilla de /opt/sellpoint/.env — NO se completa acá ni pasa por el chat.
#
# El bootstrap/deploy genera el archivo real DIRECTO en el server (D9 del
# proposal f0-deploy). Este archivo es solo documentación de qué variables
# existen y qué formato esperan. Permisos del real: 600, owner deploy.
#
# Un solo archivo: docker compose lo usa tanto para interpolar ${IMAGE_TAG}
# en docker-compose.prod.yml como para `env_file:` de api/postgres/migrate.

NODE_ENV=production
PORT=3000

# --- Postgres ---
# Gotcha: @, / y : rompen la URI de DATABASE_URL. Generar con
# `openssl rand -base64 32 | tr -d '/+='` (alfanumérico, sin caracteres especiales).
POSTGRES_USER=sellpoint
POSTGRES_PASSWORD=
POSTGRES_DB=sellpoint_prod
DATABASE_URL=postgresql://sellpoint:<POSTGRES_PASSWORD>@postgres:5432/sellpoint

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- CORS (defensa en profundidad; VITE_API_URL relativo ya evita el problema, D8) ---
CORS_ORIGINS=https://laradoc.com,https://www.laradoc.com

# --- Imágenes (deploy.yml las escribe en cada corrida) ---
GHCR_OWNER=carloshlm
IMAGE_TAG=REEMPLAZAR_CON_SHA_COMPLETO  # SIEMPRE un SHA de commit, nunca latest (D10: rollback por tag)
